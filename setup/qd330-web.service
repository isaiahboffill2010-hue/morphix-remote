[Unit]
Description=QD330 printer control dashboard
After=network-online.target qd330-dhcp.service
Wants=network-online.target

[Service]
User=jd
WorkingDirectory=/home/jd/pi-manager
EnvironmentFile=-/etc/qd330-web.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m printer_control.web
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
